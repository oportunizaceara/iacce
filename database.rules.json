{
  "rules": {
    ".read": false,
    ".write": false,
    "meta": {
      "adminProbe": {
        ".read": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
        ".write": false
      }
    },
    "courses": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
      "$courseId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role != 'viewer'",
        ".validate": "!newData.exists() || newData.hasChildren()"
      }
    },
    "responsibles": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
      "$lotId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role != 'viewer'"
      }
    },
    "lotResponsibles": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role != 'viewer'"
    },
    "courseChecklists": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
      "$courseId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role != 'viewer'"
      }
    },
    "calendarEvents": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role != 'viewer'"
    },
    "calendarTasks": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role != 'viewer'"
    },
    "lastSync": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role != 'viewer'",
      ".validate": "!newData.exists() || newData.isString()"
    },
    "actionLogs": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
      "$logId": {
        ".write": "auth != null && auth.token.role != 'viewer' && (!data.exists() || auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')"
      }
    },
    "users": {
      ".read": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
        ".write": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')"
      }
    },
    "instructors": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.email == 'admin@iac.com' || auth.token.email == 'administrador@iac.com' || auth.token.email == 'alissonh26@gmail.com')",
      "$instructorId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role != 'viewer'"
      }
    },
    "perfilLote": {
      "relatorios": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role != 'viewer'"
      }
    }
  }
}
